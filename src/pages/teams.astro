---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCard from '../components/TeamCard.astro';
import MailtoForm from '../components/MailtoForm.astro';
import { getCollection } from 'astro:content';
const teams = await getCollection('teams');
const filters = [['all', 'All'], ['U13', 'Under 13'], ['U16', 'Under 16'], ['U19', 'Under 19'], ['girls', 'Girls'], ['beginner', 'Beginner']];
---
<BaseLayout title="Find a team">
  <h1 class="text-3xl font-medium">Find your squad</h1>
  <p class="mt-2 text-sky">No experience needed. Most teams start beginners.</p>
  <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter teams">
    {filters.map(([k, label]) => (
      <button type="button" data-f={k} class="f rounded-full px-3 py-1 text-xs bg-navy-line aria-pressed:bg-gold aria-pressed:text-gold-ink" aria-pressed={k === 'all'}>{label}</button>
    ))}
  </div>
  <div class="mt-4 grid gap-3" id="list">
    {teams.map((t) => (
      <div data-age={t.data.ageGroups.join(' ')} data-level={t.data.level} data-girls={String(t.data.girls)}>
        <TeamCard {...t.data} />
      </div>
    ))}
  </div>
  <p class="mt-4 text-xs text-sky">Listings marked sample are placeholders. Real teams are verified before they appear.</p>
  <h2 class="mt-8 text-lg font-medium">Run a team or club?</h2>
  <p class="mt-1 max-w-xl text-sm text-sky">Send us your details. We check every listing before it goes live.</p>
  <MailtoForm id="team-form" subject="CricInspire team listing" button="Send team details">
    <label class="grid gap-1 text-sm">Team or club name<input name="team" required class="rounded-lg bg-navy-card px-3 py-2" /></label>
    <label class="grid gap-1 text-sm">City and state<input name="location" required class="rounded-lg bg-navy-card px-3 py-2" /></label>
    <label class="grid gap-1 text-sm">Age groups and level<input name="ages_level" required class="rounded-lg bg-navy-card px-3 py-2" /></label>
    <label class="grid gap-1 text-sm">Website or contact for families<input name="contact" required class="rounded-lg bg-navy-card px-3 py-2" /></label>
  </MailtoForm>
  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.f');
    const items = document.querySelectorAll<HTMLElement>('#list > div');
    btns.forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.f!;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((el) => {
        const show = k === 'all' || (k === 'girls' ? el.dataset.girls === 'true' : k === 'beginner' ? el.dataset.level === 'beginner' : el.dataset.age!.split(' ').includes(k));
        el.hidden = !show;
      });
    }));
  </script>
</BaseLayout>
