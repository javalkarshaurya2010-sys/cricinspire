---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const extras = [
  ['Cricket vs baseball', '/learn/vs-baseball', 'Side by side for American fans'],
  ['Glossary', '/learn/glossary', 'Search every cricket word'],
  ['Gear guide', '/learn/gear', 'What to bring and what it costs'],
  ['Drills', '/learn/drills', 'Backyard practice ideas'],
];
const badges = [
  [1, 'Opening bat', 'Finish your first lesson'],
  [4, 'Half-century club', 'Finish 4 lessons'],
  [8, 'Centurion', 'Finish all 8 lessons'],
];
---
<BaseLayout title="Cricket 101">
  <h1 class="text-3xl font-medium">Cricket 101</h1>
  <p class="mt-2 text-sky">Know baseball? You are already halfway there. Answer each quick check to earn badges.</p>

  <section class="mt-5 rounded-2xl bg-navy-card p-4" id="progress" data-total={lessons.length}>
    <p class="text-sm"><span id="done-count" class="font-medium">0</span> of {lessons.length} lessons done</p>
    <div class="mt-2 h-2 rounded-full bg-navy-line"><div id="bar" class="h-2 rounded-full bg-gold" style="width:0%"></div></div>
    <ul class="mt-3 flex flex-wrap gap-2">
      {badges.map(([n, name, how]) => (
        <li data-badge={n} class="badge rounded-full bg-navy-line px-3 py-1 text-xs opacity-50" title={how as string}>{name}</li>
      ))}
    </ul>
  </section>

  <ol class="mt-6 grid gap-3">
    {lessons.map((l) => (
      <li><a href={`/learn/${l.id}`} data-lesson={l.id} class="lesson block rounded-2xl bg-navy-card p-4 hover:bg-navy-line">
        <span class="text-xs text-gold">Lesson {l.data.order} · {l.data.readMinutes} min <span class="tick hidden">· Done</span></span>
        <h2 class="font-medium">{l.data.title}</h2>
        <p class="text-sm text-sky">{l.data.summary}</p>
      </a></li>
    ))}
  </ol>

  <h2 class="mt-8 text-lg font-medium">More ways to learn</h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    {extras.map(([t, href, d]) => (
      <a href={href} class="rounded-2xl bg-navy-card p-4 hover:bg-navy-line"><p class="font-medium">{t}</p><p class="text-sm text-sky">{d}</p></a>
    ))}
  </div>

  <script>
    let done: string[] = [];
    try { done = JSON.parse(localStorage.getItem('cric-done') || '[]'); } catch {}
    const total = Number(document.getElementById('progress')!.dataset.total);
    document.getElementById('done-count')!.textContent = String(done.length);
    (document.getElementById('bar') as HTMLElement).style.width = `${Math.round((done.length / total) * 100)}%`;
    document.querySelectorAll<HTMLElement>('.lesson').forEach((a) => {
      if (done.includes(a.dataset.lesson!)) a.querySelector('.tick')!.classList.remove('hidden');
    });
    document.querySelectorAll<HTMLElement>('.badge').forEach((b) => {
      if (done.length >= Number(b.dataset.badge)) { b.classList.remove('opacity-50', 'bg-navy-line'); b.classList.add('bg-gold', 'text-gold-ink'); }
    });
  </script>
</BaseLayout>
