---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import Countdown from '../components/Countdown.astro';
import { getCollection } from 'astro:content';
const stories = (await getCollection('stories', (s) => !s.data.draft)).slice(0, 3);
---
<BaseLayout title="Home">
  <section class="py-6">
    <span class="inline-block rounded-full bg-red px-3 py-1 text-xs font-medium">Cricket is going Olympic · LA28</span>
    <h1 class="mt-4 text-4xl font-medium leading-tight">You could play on the biggest stage in 2028.</h1>
    <p class="mt-3 max-w-md text-sky">New to cricket? Cool. Learn it in 10 minutes, read stories from players your age, and find a team near you.</p>
    <div class="mt-5 flex gap-3 flex-wrap">
      <a href="/learn" class="rounded-full bg-gold text-gold-ink px-5 py-2.5 text-sm font-medium">Learn in 10 minutes</a>
      <a href="/teams" class="rounded-full border-[1.5px] border-white px-5 py-2.5 text-sm">Find a team</a>
    </div>
    <div class="mt-5 flex max-w-md items-center gap-3 rounded-full bg-navy-card py-1.5 pl-4 pr-1.5 text-sm text-white">
      <span class="flex-1">Our mission: help every kid in America discover cricket.</span>
      <a href="/about" class="shrink-0 rounded-full bg-gold text-gold-ink px-4 py-2 text-xs font-medium">Read my story</a>
    </div>
  </section>
  <section class="grid gap-3 sm:grid-cols-3 my-6">
    <div class="rounded-2xl bg-blue p-4"><p class="text-2xl font-medium">T20</p><p class="text-sm opacity-85">One match, about 3 hours</p></div>
    <div class="rounded-2xl bg-green p-4"><p class="text-2xl font-medium">Pomona, CA</p><p class="text-sm opacity-85">LA28 cricket venue</p></div>
    <div class="rounded-2xl bg-coral p-4"><p class="text-2xl font-medium">Jul 14-30, 2028</p><p class="text-sm opacity-85">Olympic Games · <Countdown /></p></div>
  </section>
  <section>
    <h2 class="text-lg font-medium mb-3">Fresh from the community</h2>
    <div class="grid gap-3 sm:grid-cols-3">
      {stories.map((s) => <StoryCard slug={s.id} {...s.data} />)}
    </div>
  </section>
</BaseLayout>
