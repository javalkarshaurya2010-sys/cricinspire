---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About and safety">
  <h1 class="text-3xl font-medium">About and safety</h1>
  <div class="mt-4 max-w-2xl space-y-3 text-sky">
    <p>CricInspire helps US teens discover cricket, learn the game, and find a team.</p>
    <p>Every teen submission is reviewed by an adult before publishing. A parent or guardian must consent before a teen name or photo appears.</p>
    <p>We do not collect personal data from children under 13 and we do not run ads or trackers aimed at minors.</p>
  </div>
</BaseLayout>
